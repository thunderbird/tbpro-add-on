DATABASE_URL=postgres://postgres:postgres@db:5432/send-suite
# Direct (non-pooled) URL for `prisma migrate deploy` / schema commands only.
# In prod (Neon) point this at the direct endpoint, NOT the -pooler one, so the
# migration advisory lock is stable. Locally there is no pooler, so it matches
# DATABASE_URL. See prisma/schema.prisma (directUrl) and tbpro-add-on#1069.
DIRECT_DATABASE_URL=postgres://postgres:postgres@db:5432/send-suite
BASE_URL=https://localhost:8088

# Run `prisma migrate deploy` from the container entrypoint on boot.
# Default OFF. EKS runs migrations as a separate Sync-phase Job, so leave this
# unset there. The legacy ECS task definition MUST set it to "true" (the
# entrypoint is its only migration path) AND MUST also set DIRECT_DATABASE_URL,
# because migrate deploy now hard-requires the direct URL -- setting only this var
# makes the container fail closed on boot. For compose local dev this .env value
# is read by node's dotenv, not by entry.sh's shell, so compose.yml enables the
# entrypoint migration via its own `environment:` block; this line is the
# mechanism for the env_file-based CI path (compose.ci.yml). See scripts/entry.sh.
RUN_MIGRATIONS_ON_BOOT=true

DEVELOPER_TIMEZONE=US/Eastern

# Logging
ERROR_LOG=logs/error.log
COMBINED_LOG=logs/combined.log

# Sentry
SENTRY_ORG=thunderbird
SENTRY_PROJECT=send-suite-backend
SENTRY_DSN=https://85b7b08be94b8991ed121578d807f755@o4505428107853824.ingest.us.sentry.io/4507567071232000
# Build-time only, for the sourcemap upload; nothing at runtime reads it. The
# image build takes it as a BuildKit secret (see Dockerfile), and no deployed
# task definition or pod carries it. Leave empty locally.
SENTRY_AUTH_TOKEN=

# Storage backend values:
# `s3` stores to S3 compatible storage
# `b2` stores to Backblaze, using the native (non-S3) API
# `fs` stores to the local filesystem -- on its way out, and no longer the
# default: every deployment is a bucket, and the dev stack now matches. The
# default below is the MinIO service in compose.yml, which needs no account and
# no credentials.
STORAGE_BACKEND=s3

SEND_BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

FS_LOCAL_DIR=
FS_LOCAL_BUCKET=send-fs-local

# for Backblaze B2 bucket
B2_REGION=
B2_ENDPOINT=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# for S3 compatible bucket. These defaults are the compose MinIO service, not a
# credential.
S3_REGION=us-east-1
# Where the backend reaches the bucket: a service name on the compose network.
S3_ENDPOINT=http://minio:9000
# Where the *browser* reaches it. A presigned URL is only valid for the host it
# was signed for, and `minio:9000` means nothing outside the container network.
# Leave empty in production, where one address serves both.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO is reached at a bare host:port, so the bucket cannot be a subdomain.
# Leave empty for a bucket that supports virtual-hosted addressing.
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=send-local

# The bucket the storage round-trip suite writes to -- its own, separate from the
# one the dev stack uploads to above. Same MinIO service in compose.yml, which
# `docker compose up` now starts as part of the stack; these are its settings,
# not a credential. The suite requires it and fails if nothing answers -- these
# values are also its defaults, so an older checkout works without copying this
# block in. If another worktree already holds 9000, start MinIO with
# SEND_MINIO_PORT set and point S3_PUBLIC_ENDPOINT and TEST_MINIO_ENDPOINT at the
# same port.
TEST_MINIO_ENDPOINT=http://localhost:9000
TEST_MINIO_REGION=us-east-1
TEST_MINIO_ACCESS_KEY=minioadmin
TEST_MINIO_SECRET_KEY=minioadmin
TEST_MINIO_BUCKET_NAME=send-test

# Posthog
POSTHOG_API_KEY=keys
POSTHOG_HOST=https://us.i.posthog.com

# JWT
ACCESS_TOKEN_SECRET=access_token_secret
REFRESH_TOKEN_SECRET=refresh_token_secret

ALLOW_PUBLIC_LOGIN=true

# OIDC/Keycloak Authentication
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_INTROSPECTION_URL=



