generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Direct (non-pooled) connection used ONLY by schema commands
  // (`prisma migrate deploy`, `migrate dev`, `db push`, introspect). WHY:
  // migrate takes a session-scoped Postgres advisory lock, which is unreliable
  // through Neon's `-pooler` (PgBouncer transaction-pooling) endpoint that
  // DATABASE_URL points at in prod. Point DIRECT_DATABASE_URL at the direct
  // Neon endpoint. Locally/compose there is no pooler, so set it equal to
  // DATABASE_URL. The runtime app (Prisma Client queries) still uses `url`, so
  // the running pod does not need DIRECT_DATABASE_URL. See tbpro-add-on#1069.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                  String       @id @unique @default(uuid()) @db.Uuid
  email               String?
  thundermailEmail    String?      @unique
  name                String?
  publicKey           String?
  tier                UserTier
  createdAt           DateTime?
  updatedAt           DateTime?
  activatedAt         DateTime?
  uniqueHash          String?
  hashedPassword      String?
  oidcSubject         String?      @unique
  backupKeypair       String?
  backupContainerKeys String?
  backupKeystring     String?
  backupSalt          String?
  containers          Container[]
  groups              Membership[]
  profile             Profile?
  shares              Share[]      @relation("Sender")
  uploads             Upload[]
  isFTUEComplete      Boolean      @default(false)
  isAdmin             Boolean      @default(false)
}

model Profile {
  mozid        String  @unique
  avatar       String?
  userId       String  @id @unique @default(uuid()) @db.Uuid
  accessToken  String?
  refreshToken String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id        Int          @id @default(autoincrement())
  container Container?
  members   Membership[]
}

model Membership {
  groupId    Int
  userId     String @db.Uuid
  permission Int    @default(0)
  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

model Share {
  id          Int          @id @default(autoincrement())
  containerId String       @db.Uuid
  senderId    String       @db.Uuid
  accessLinks AccessLink[]
  container   Container    @relation("SharedFolder", fields: [containerId], references: [id], onDelete: Cascade)
  sender      User         @relation("Sender", fields: [senderId], references: [id])
}

model AccessLink {
  id                  String    @unique
  shareId             Int
  wrappedKey          String
  salt                String
  challengeKey        String
  challengeSalt       String
  challengeCiphertext String
  challengePlaintext  String
  permission          Int       @default(0)
  expiryDate          DateTime?
  retryCount          Int       @default(0)
  locked              Boolean   @default(false)
  hasPassword         Boolean   @default(true)
  share               Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model Container {
  id         String        @id @unique @default(uuid()) @db.Uuid
  name       String
  createdAt  DateTime?
  updatedAt  DateTime?
  type       ContainerType
  shareOnly  Boolean       @default(false)
  ownerId    String        @db.Uuid
  groupId    Int           @unique
  wrappedKey String?
  parentId   String?       @db.Uuid
  isDefault  Boolean       @default(false)
  group      Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  owner      User          @relation(fields: [ownerId], references: [id])
  parent     Container?    @relation("Nesting", fields: [parentId], references: [id])
  children   Container[]   @relation("Nesting")
  items      Item[]
  shares     Share[]       @relation("SharedFolder")
}

model Item {
  id          Int       @id @default(autoincrement())
  name        String
  wrappedKey  String
  containerId String    @db.Uuid
  uploadId    String    @db.Uuid
  type        ItemType
  multipart   Boolean   @default(false)
  totalSize   BigInt?
  createdAt   DateTime?
  updatedAt   DateTime?
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  upload      Upload    @relation(fields: [uploadId], references: [id])
}

model Upload {
  id         String    @id @default(uuid()) @db.Uuid
  size       BigInt
  ownerId    String    @db.Uuid
  type       String
  createdAt  DateTime?
  reported   Boolean   @default(false)
  reportedAt DateTime?
  part       Int?
  fileHash   String?
  items      Item[]
  owner      User      @relation(fields: [ownerId], references: [id])
}

// A presigned upload URL that has not been finalized into an Upload row yet.
// Counts toward quota until expiresAt; expired rows are swept with their bytes.
// No relation to User on purpose: the row must outlive its owner so the sweep
// can still remove the object.
model PendingUpload {
  id        String    @id @db.Uuid
  ownerId   String    @db.Uuid
  size      BigInt?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  sweptAt   DateTime?

  @@index([ownerId, expiresAt])
  @@index([expiresAt])
}

// One run of the orphaned-storage sweep. Instances coordinate through these
// rows and an advisory lock; `cursor` is the last bucket key handled, so the
// next sweep resumes the listing there.
model StorageSweep {
  id            Int       @id @default(autoincrement())
  instanceId    String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  cursor        String?
  dryRun        Boolean   @default(false)
  capped        Boolean   @default(false)
  rowOrphans    Int       @default(0)
  bucketOrphans Int       @default(0)
  deleted       Int       @default(0)
  kept          Int       @default(0)
  errors        Int       @default(0)
  error         String?

  @@index([startedAt])
}

model SuspiciousFile {
  id       String @id @unique @default(uuid()) @db.Uuid
  fileHash String @unique
}

model Login {
  fxasession String    @id
  createdAt  DateTime?
}

enum UserTier {
  PRO
  EPHEMERAL
  FREE
}

enum ContainerType {
  CONVERSATION
  FOLDER
}

enum ItemType {
  MESSAGE
  FILE
}
