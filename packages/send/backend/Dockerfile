# Two build arguments are possible, development and production.
# We use these to add contitional build differences.
ARG BUILD_ENV=production

FROM node:22.14.0 AS base

# Update packages
RUN apt update -y && apt upgrade -y

WORKDIR /app

# Copy only dependency manifests first so the install layer is only
# invalidated when deps change, not when source changes.
ADD package.json \
    tsconfig.json \
    tsconfig.build.json \
    ./

# build production — lockfile copied here via ONBUILD, then install runs
FROM base AS build_lockfile_production
ONBUILD RUN echo "Add pnpm-lock.yaml"
ONBUILD ADD pnpm-lock.yaml ./

# build development — no lockfile (resolved at workspace root)
FROM base AS build_lockfile_development
ONBUILD RUN echo "Don't add pnpm-lock.yaml"

FROM build_lockfile_${BUILD_ENV} AS build_app
RUN npm install -g pnpm@10
# Create workspace config to allow build scripts (pnpm 9+ security requirement).
# Without this, pnpm blocks postinstall scripts for prisma, sentry, etc.
RUN printf 'packages:\n  - "."\nonlyBuiltDependencies:\n  - "@prisma/client"\n  - "@prisma/engines"\n  - "@scarf/scarf"\n  - "@sentry/cli"\n  - "@sentry/profiling-node"\n  - prisma\n' > pnpm-workspace.yaml
# prisma must be present before install: prisma's postinstall runs `prisma generate`
ADD prisma ./prisma
# Use --no-lockfile: the pnpm-lock.yaml (whether from pnpm deploy or the workspace root)
# contains workspace-qualified peer-dep specs that pnpm cannot resolve in a
# standalone container context. Install from package.json alone.
RUN pnpm install --no-lockfile

# Remaining source copied AFTER install so source changes don't bust the dep layer cache.
ADD public ./public
ADD scripts ./scripts
ADD src ./src
ADD vitest.integration.config.js ./

# Build the runtime artifact (dist/) at IMAGE BUILD time, not at container start.
# WHY: the runtime image must run pre-built `dist` (node dist/index.js). The old
# `prestart` script recompiled TypeScript AND ran a Sentry sourcemap upload on
# every boot, which forced a build/CI credential (SENTRY_AUTH_TOKEN) into the
# running pod and crash-looped it when the token was absent (tbpro-add-on#1112).
# Compiling here means the runtime pod needs no build tooling and no Sentry token.
# (`pnpm run build` == `tsc && tsc-alias` against tsconfig.build.json, which keeps
# tests out of the shipped dist/ -- see that file.) The Prisma client is already
# generated by prisma's postinstall during `pnpm install` above, so no separate
# generate step is needed here or at boot.
RUN pnpm run build

# Sentry sourcemaps, at build time only -- never at container start.
# `inject` embeds debug IDs into the emitted JS + maps and needs no credentials,
# so it always runs (the shipped dist is self-describing to Sentry). `upload`
# publishes the maps and DOES need a token, so it is opt-in via a BuildKit secret
# and is skipped (with a notice) when the secret is absent -- e.g. local builds
# and the legacy ECR build in merge.yml, which pass none. This keeps a Sentry org
# token out of both the image layers and the runtime pod.
#
# The EKS/GHCR release path DOES upload: publish-images.yml forwards a
# SENTRY_AUTH_TOKEN repo secret to build-multiarch-image.yml, which passes it here
# as `--secret id=sentry_auth_token`. The legacy ECR build (merge.yml, off-limits)
# passes none, so backend sourcemaps stop uploading there until its owner wires the
# same secret -- called out in the PR. The inject/upload commands live in
# package.json (sentry:sourcemaps:{inject,upload}) so the org/project names have a
# single source of truth.
#
# `inject` is fatal, `upload` is not: injection is local and its output is what
# makes the shipped dist self-describing, but a failed upload (rotated token,
# Sentry API blip) means only missing telemetry -- it must not break image
# publication and strand a Kargo promotion with no Freight.
RUN --mount=type=secret,id=sentry_auth_token,required=false \
    pnpm sentry:sourcemaps:inject && \
    if [ -s /run/secrets/sentry_auth_token ]; then \
      echo "Uploading sourcemaps to Sentry"; \
      SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token)" \
        pnpm sentry:sourcemaps:upload \
        || echo "WARNING: sourcemap upload failed; shipping injected dist without uploaded maps"; \
    else \
      echo "No sentry_auth_token build secret; skipping sourcemap upload (dist injected, not uploaded)"; \
    fi

# runtime production
FROM build_app AS runtime_production
# Set environment vartiable for runtime container user name
ENV runtime_user=send
# Add runtime user
ONBUILD RUN echo "Add runtime user"
ONBUILD RUN useradd -m ${runtime_user} -d /home/${runtime_user}
# Chown /app to runtime_user
ONBUILD RUN chown -Rf ${runtime_user} /app
# Switch to runtime user
ONBUILD USER ${runtime_user}

# runtime dev
FROM build_app AS runtime_development
ONBUILD RUN echo "Don't add runtime user"
ONBUILD RUN chown -Rvf node:node /app

FROM runtime_${BUILD_ENV}

CMD ["/bin/sh", "/app/scripts/entry.sh"]