# Two build arguments are possible, development and production.
# We use these to add contitional build differences.
ARG BUILD_ENV=production

FROM node:22.14.0 AS base

WORKDIR /app

# Copy dependency manifests first; defer frontend source until after install so
# source-only changes don't bust the pnpm install layer cache.
COPY package.json \
    pnpm-lock.yaml \
    pnpm-workspace.yaml \
    nx.json \
    lerna.json \
    ./
COPY packages/send/frontend/package.json ./packages/send/frontend/package.json

# Install dependencies. Exact pnpm version (matches the nightly e2e workflows);
# the pnpm package has no install scripts. --frozen-lockfile installs exactly the
# locked versions; lifecycle scripts stay limited to the workspace's
# onlyBuiltDependencies allowlist (pnpm 10 blocks the rest by default).
RUN npm install -g --ignore-scripts pnpm@10.34.7
RUN pnpm install --frozen-lockfile

# Copy frontend source after install
COPY packages/send/frontend ./packages/send/frontend

# runtime production
FROM base AS runtime_production
# Set environment variable for runtime container user name
ENV runtime_user=frontend
# Add runtime user
ONBUILD RUN echo "Add runtime user"

# Add runtime user
RUN useradd ${runtime_user} -d /home/${runtime_user}
# Chown /app to runtime_user
RUN chown -Rf ${runtime_user} /app
# Switch to runtime user
USER ${runtime_user}

# runtime development
FROM base AS runtime_development
ONBUILD RUN echo "Don't add runtime user"

FROM runtime_${BUILD_ENV}
ENV CI=true

# pnpm install is a no-op when deps are baked in, but required locally where compose.yml
# volume-mounts the host tree over /app and overwrites the image's node_modules.
CMD ["sh", "-c", "pnpm install && pnpm --filter send-frontend run dev"]
